# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ems-production

# JWT (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-256-bit-random-secret-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-256-bit-random-refresh-secret-at-least-32-characters-long
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Frontend
FRONTEND_URL=https://app.yourdomain.com

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Cloudinary (Optional, for remote image storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Super Admin
SUPER_ADMIN_EMAIL=admin@companydomain.com
SUPER_ADMIN_PASSWORD=ChangeMe@123456789ABC

# Demo Data (For seeding)
DEMO_TENANT_NAME="Demo Company Pvt Ltd"
DEMO_TENANT_EMAIL="demo@democompany.com"
DEMO_TENANT_PHONE="+91 9876543210"
DEMO_ADMIN_NAME="Demo Admin"
DEMO_ADMIN_EMAIL="admin@democompany.com"
DEMO_ADMIN_PASSWORD="Demo@123456"
DEMO_EMPLOYEE_PASSWORD="Emp@123456"
DEMO_EMPLOYEE_EMAIL_PREFIX="emp"
DEMO_EMPLOYEE_EMAIL_DOMAIN="democompany.com"

# Payment (Razorpay)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Logging
LOG_LEVEL=info

# Redis (Optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
# Alternatively, use REDIS_URL for connection strings (e.g. on Render or Heroku)
# REDIS_URL=redis://localhost:6379

# Sentry (Optional, for error tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Email Configuration
EMAIL_MODE=sandbox # options: "resend" | "smtp" | "sandbox"
EMAIL_FROM_NAME=EMS
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# SMTP Configuration (For standard email providers)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Resend Configuration (Alternative API based sending)
RESEND_API_KEY=re_your_api_key_here

